# Copy to .env for local development. Never commit .env. Secrets are referenced by
# name only (see techdocs/coding_standards_techdoc.md §8).

ENV=dev
HTTP_ADDR=:8080

# Postgres (matches docker-compose).
DATABASE_URL=postgres://copilot:copilot@localhost:5432/copilot?sslmode=disable

REDIS_URL=redis://localhost:6379
NATS_URL=nats://localhost:4222

# OTLP/HTTP traces endpoint (otel-collector in docker-compose).
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4318

# HMAC key for session tokens. Generate a strong random value; do not reuse in prod.
# Not required while AUTH_DISABLED=true.
AUTH_SIGNING_KEY=dev-only-change-me

# DEV ONLY: skip login on the realtime endpoint and use DEV_TENANT_ID. Lets us build
# the core pipeline before login/OAuth exists. Ignored unless ENV=dev.
AUTH_DISABLED=true
DEV_TENANT_ID=00000000-0000-0000-0000-000000000001

# ---- STT / transcription (Stage 2) -----------------------------------------
# Deepgram streaming STT key — a SECRET (vault: secrets.KeyDeepgramAPI). Held
# server-side only; never shipped to the desktop client (transcription D2).
DEEPGRAM_API_KEY=
STT_PROVIDER=deepgram   # selects the STT adapter
STT_MODEL=nova-3        # Deepgram model
STT_ENDPOINTING_MS=300  # silence (ms) that marks end-of-turn (feature 2.4)

# ---- Suggest / transcript store (Stage 3) -----------------------------------
# Default transcript window a Suggest click reads (per-click WS override wins).
SUGGEST_LOOKBACK_MS=90000
# Sliding TTL on the Redis transcript key: refreshed on every utterance, so the
# transcript is deleted this long after the call goes quiet.
TRANSCRIPT_TTL_SECONDS=1800

# ---- LLM extraction (retrieval step 1) ---------------------------------------
# Provider is a registry name (anthropic | openai_compatible). openai_compatible
# covers Groq/DeepSeek/OpenAI/Gemini/Ollama — pick the vendor via BASE_URL.
# Default: Groq free tier (key from console.groq.com goes in OPENAI_API_KEY).
LLM_EXTRACT_PROVIDER=openai_compatible
LLM_EXTRACT_MODEL=openai/gpt-oss-20b
LLM_EXTRACT_BASE_URL=https://api.groq.com/openai/v1
LLM_EXTRACT_MAX_TOKENS=300
# Key for the openai_compatible provider (Groq/DeepSeek/OpenAI/Gemini). SECRET.
# Also used by the embedder below.
OPENAI_API_KEY=
# Key for the anthropic provider. SECRET.
ANTHROPIC_API_KEY=

# ---- Knowledge-base ingest (Stage 4) ------------------------------------------
# Default: Gemini gemini-embedding-001, asked for 768 dims. Groq serves NO embedding models.
EMBED_PROVIDER=openai_compatible
EMBED_MODEL=gemini-embedding-001
EMBED_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Embedding key (aistudio.google.com). SECRET. Unset ⇒ falls back to OPENAI_API_KEY.
EMBED_API_KEY=
# Must match the migration's vector(768); changing the model = new migration + re-embed.
EMBED_DIMS=768
EMBED_BATCH_SIZE=64
# Approximate tokens (chars/4). Tune only with eval data (Stage 13).
CHUNK_TARGET_TOKENS=450
CHUNK_OVERLAP_TOKENS=60
MAX_UPLOAD_MB=15

# ---- Retrieval search (Stage 5) -------------------------------------------------
# Chunks returned per Suggest click.
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.5

# ---- Suggestion generation (Stage 6) ---------------------------------------------
# Answer role: turns retrieved chunks into the rep-facing card. Same registry as
# LLM_EXTRACT_*; swap provider/model by env only.
LLM_ANSWER_PROVIDER=openai_compatible
LLM_ANSWER_MODEL=openai/gpt-oss-120b
LLM_ANSWER_BASE_URL=https://api.groq.com/openai/v1
# Reasoning models (gpt-oss) spend "thinking" tokens against this cap — keep it roomy.
LLM_ANSWER_MAX_TOKENS=2000
# Card gate: top hit score below this = no card (hits still sent). Calibrate in Stage 13.
SUGGEST_MIN_CONFIDENCE=0.5

# ---- Post-call summary (Stage 10) --------------------------------------------------
# Summary role: full transcript -> summary + action items + unanswered questions at
# call end (customer calls only). Same provider registry; not latency-critical.
LLM_SUMMARY_PROVIDER=openai_compatible
LLM_SUMMARY_MODEL=openai/gpt-oss-120b
LLM_SUMMARY_BASE_URL=https://api.groq.com/openai/v1
LLM_SUMMARY_MAX_TOKENS=1500

# ---- Prep chat (Stage 10.8) ---------------------------------------------------------
# Chat role: prepare for the next meeting with a customer, grounded in that
# customer's past meeting digests + KB docs. Every context knob is env-driven.
LLM_CHAT_PROVIDER=openai_compatible
LLM_CHAT_MODEL=openai/gpt-oss-120b
LLM_CHAT_BASE_URL=https://api.groq.com/openai/v1
LLM_CHAT_MAX_TOKENS=2500
# Newest digests always in context / semantically retrieved digests / KB chunks / history cap.
CHAT_RECENT_SUMMARIES=2
CHAT_TOPK_SUMMARIES=5
CHAT_TOPK_CHUNKS=5
CHAT_MAX_TURNS=12
